{
  "name": "dsh-github-copilot-accounts",
  "version": "0.3.5-dsh-0.2.2-rc.1",
  "description": "GitHub Copilot 多账号与会话绑定：设备码登录、全局默认与会话账号隔离、额度展示及续接状态保护。",
  "type": "module",
  "license": "MIT",
  "author": "JacobCodeShow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobCodeShow/dsh-github-copilot-accounts.git"
  },
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./default-model": "./src/default-model.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "test:ui": "node scripts/validate-session-ui.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "yaml": "^2.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
